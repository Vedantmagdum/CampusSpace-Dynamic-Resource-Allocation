# Local development uses SQLite if DATABASE_URL is omitted.
# PostgreSQL example (replace credentials/host with your database values):
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@your-college.edu
ADMIN_PASSWORD=replace-with-a-strong-unique-password
LIBRARY_QR_TOKEN=replace-with-a-long-random-token

# Seat map colour for FREE (tap-to-book) sections: red (default) or green. Booked sections use the other colour.
SEAT_FREE_COLOR=red

# Only emails on these domains can register or sign in (comma separated). Use * to turn the restriction off.
# If empty, the domain of ADMIN_EMAIL is used.
ORG_EMAIL_DOMAINS=yourcollege.edu
# Faculty also need admin approval by default. Set to true to let faculty sign in right after registering.
FACULTY_AUTO_APPROVE=false
